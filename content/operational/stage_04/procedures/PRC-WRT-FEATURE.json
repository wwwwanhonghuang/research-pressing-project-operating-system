    "科学ライター"
  ],
  "inputs": [
    "構成案",
    "一次資料",
    "確認済み引用",
    "読者設定"
  ],
  "outputs": [
    "初稿",
    "段落別の根拠対応",
    "暫定見出し・脚注"

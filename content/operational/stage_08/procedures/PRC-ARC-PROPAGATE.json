    {
      "id": "PRC-ARC-PROPAGATE-S4",
      "instruction": "異なる端末・閲覧条件で読者に見える訂正表示を点検する",
      "expected_output": "公開結果独立確認",
      "evidence_needed": true
    },
    {
      "id": "PRC-ARC-PROPAGATE-S5",
      "instruction": "関係者への通知と未達・キャッシュ遅延を記録する",

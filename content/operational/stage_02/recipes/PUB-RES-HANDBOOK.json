  "chapter_plan": [
    {
      "chapter_id": "CH-RES-INTRO",
      "heading_ja": "目的・対象・情報構造",
      "parts": [
        {
          "kind": "editorial_bridge",
          "editorial_text": "本書は、企画で定めた問いを原資料に結びつけ、研究方法と主張の根拠を評価し、次の取材・執筆へ引き継ぐための独立した業務設計試案である。探索から引継ぎまでの各判断に資料の識別子、版、確認日と責任を持たせる。"
        },
        {
          "kind": "editorial_bridge",
          "editorial_text": "本文は研究調査、科学コミュニケーション、編集制作の場面を想定する。研究の査読、研究不正認定、法律上の許認可、組織の公式な公開承認を代替しない。正確性に関する原典確認と、倫理・権利・組織権限の確認を分けて扱う。"
        }
      ]
    },
    {
      "chapter_id": "CH-RES-SRC",
      "heading_ja": "調査の単位と資料・主張の関係",
      "parts": [
        {
          "kind": "editorial_bridge",
          "editorial_text": "資料記録は SourceRecord、科学的に意味のある個々の命題は ClaimRecord として区別する。資料の識別子、版、引用位置、資料が主張を支持又は限定する関係を明記する。本文の参考文献表示と内部の来歴管理は相互に接続する。"
        },
        {
          "kind": "editorial_bridge",
          "editorial_text": "科学的主張の区分は、観測、推定、解釈、仮説、予測、研究目標を基本とする。対象集団・方法・尺度・時間範囲の違いを後続の編集で失わないよう、必要な留保を主張ごとに保存する。"
        }
      ]
    },

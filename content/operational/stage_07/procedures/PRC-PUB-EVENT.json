    "運営進行台本・緊急連絡表"
  ],
  "steps": [
    {
      "id": "PRC-PUB-EVENT-S1",
      "instruction": "参加者の導線、記録、配信範囲と同意条件を事前に整理する",
      "expected_output": "参加案内",
      "evidence_needed": true
    },
    {
      "id": "PRC-PUB-EVENT-S2",
      "instruction": "音響、表示、字幕、配布資料、遠隔接続を試す",

      "evidence_needed": true
    },
    {
      "id": "PRC-PUB-EVENT-S3",
      "instruction": "登壇者・司会・技術担当者に当日の役割と連絡先を配布する",
      "expected_output": "運営責任表",
      "evidence_needed": true
    },
    {
      "id": "PRC-PUB-EVENT-S4",
      "instruction": "質疑応答の記録と即答困難な質問の後日回答経路を用意する",
      "expected_output": "質問・照会対応表",
      "evidence_needed": true
    },
    {
      "id": "PRC-PUB-EVENT-S5",
      "instruction": "実施後の記録公開と個人情報の扱いを再確認する",
      "expected_output": "実施報告",
      "evidence_needed": true
    }
  ],
  "exception_handling": [
    "登壇者の発言を承認済み原稿の一部と自動的に見なさない",

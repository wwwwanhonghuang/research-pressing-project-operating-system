{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operations OS knowledge entry (pilot v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "version",
    "title_ja",
    "authority",
    "status",
    "scope",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^(STD|ETH)-[A-Z0-9-]+$"
    },
    "kind": {
      "enum": [
        "standard",
        "ethics"
      ]
    },
    "version": {
      "type": "string"
    },
    "title_ja": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "enum": [
        "binding_law",
        "official_institutional",
        "professional_guideline",
        "independent_proposal",
        "unverified"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "checked_on": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "paragraph",
              "rule",
              "commentary",
              "warning",
              "example"
            ]
          },
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}

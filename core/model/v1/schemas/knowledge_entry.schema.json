{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/operations-os/model/v1/knowledge_entry.schema.json",
  "title": "Operations OS knowledge_entry canonical v1",
  "description": "Reusable knowledge, with explicit normative provenance and scope; classification is not an assertion of legal validity.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^KNW-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "object",
      "properties": {
        "ja": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ja"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "validated_for_use",
        "deprecated",
        "withdrawn"
      ]
    },
    "responsible_role": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "independent_proposal",
            "external_source",
            "institutional_adopted"
          ]
        },
        "normative_class": {
          "type": "string",
          "enum": [
            "law",
            "regulation",
            "institutional_policy",
            "professional_guidance",
            "operational_proposal",
            "informational"
          ]
        },
        "institutional_approval": {
          "type": "string",
          "enum": [
            "none",
            "unverified",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        },
        "verified_by": {
          "type": "string",
          "minLength": 1
        },
        "applicability_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "origin",
        "normative_class",
        "institutional_approval"
      ],
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "may_share_with_external_ai": {
          "type": "boolean"
        },
        "embargo_until": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "classification",
        "may_share_with_external_ai"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          },
          "verification_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation": {
            "type": "string",
            "enum": [
              "applies_to",
              "governed_by",
              "implements",
              "requires",
              "uses",
              "supports",
              "derived_from",
              "supersedes",
              "presents",
              "assesses",
              "produces"
            ]
          },
          "target": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "knowledge_entry",
                  "procedure_definition",
                  "task_definition",
                  "document_template",
                  "checklist_definition",
                  "document_instance",
                  "checklist_run",
                  "task_run",
                  "review_decision",
                  "publication_recipe",
                  "media_asset",
                  "rendered_artifact",
                  "source_record",
                  "claim_record"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "relation",
          "target"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "standard",
        "ethics",
        "legal_reference",
        "professional_guidance",
        "scientific_background",
        "institutional_reference"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^0[1-8]$"
          },
          "minItems": 0
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "minItems": 0
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "paragraph",
              "heading",
              "list",
              "table",
              "figure",
              "equation",
              "notice",
              "example",
              "interactive_placeholder",
              "audio_reference",
              "video_reference"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "asset": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "knowledge_entry",
                  "procedure_definition",
                  "task_definition",
                  "document_template",
                  "checklist_definition",
                  "document_instance",
                  "checklist_run",
                  "task_run",
                  "review_decision",
                  "publication_recipe",
                  "media_asset",
                  "rendered_artifact",
                  "source_record",
                  "claim_record"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rights": {
      "type": "object",
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "rightsholder": {
          "type": "string",
          "minLength": 1
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "clearance": {
          "type": "string",
          "enum": [
            "not_checked",
            "pending",
            "confirmed",
            "restricted",
            "not_applicable"
          ]
        }
      },
      "required": [
        "clearance"
      ],
      "additionalProperties": false
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "knowledge_entry",
              "procedure_definition",
              "task_definition",
              "document_template",
              "checklist_definition",
              "document_instance",
              "checklist_run",
              "task_run",
              "review_decision",
              "publication_recipe",
              "media_asset",
              "rendered_artifact",
              "source_record",
              "claim_record"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "knowledge_entry",
              "procedure_definition",
              "task_definition",
              "document_template",
              "checklist_definition",
              "document_instance",
              "checklist_run",
              "task_run",
              "review_decision",
              "publication_recipe",
              "media_asset",
              "rendered_artifact",
              "source_record",
              "claim_record"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "lifecycle",
    "authority",
    "access",
    "category",
    "blocks"
  ],
  "additionalProperties": false
}

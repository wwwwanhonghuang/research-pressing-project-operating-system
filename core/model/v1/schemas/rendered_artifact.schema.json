{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/operations-os/model/v1/rendered_artifact.schema.json",
  "title": "Operations OS rendered_artifact canonical v1",
  "description": "Independent prototype; no institutional authorization is asserted.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^ART-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "object",
      "properties": {
        "ja": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ja"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "validated_for_use",
        "deprecated",
        "withdrawn"
      ]
    },
    "responsible_role": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "independent_proposal",
            "external_source",
            "institutional_adopted"
          ]
        },
        "normative_class": {
          "type": "string",
          "enum": [
            "law",
            "regulation",
            "institutional_policy",
            "professional_guidance",
            "operational_proposal",
            "informational"
          ]
        },
        "institutional_approval": {
          "type": "string",
          "enum": [
            "none",
            "unverified",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        },
        "verified_by": {
          "type": "string",
          "minLength": 1
        },
        "applicability_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "origin",
        "normative_class",
        "institutional_approval"
      ],
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "may_share_with_external_ai": {
          "type": "boolean"
        },
        "embargo_until": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "classification",
        "may_share_with_external_ai"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          },
          "verification_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation": {
            "type": "string",
            "enum": [
              "applies_to",
              "governed_by",
              "implements",
              "requires",
              "uses",
              "supports",
              "derived_from",
              "supersedes",
              "presents",
              "assesses",
              "produces"
            ]
          },
          "target": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "knowledge_entry",
                  "procedure_definition",
                  "task_definition",
                  "document_template",
                  "checklist_definition",
                  "document_instance",
                  "checklist_run",
                  "task_run",
                  "review_decision",
                  "publication_recipe",
                  "media_asset",
                  "rendered_artifact",
                  "source_record",
                  "claim_record"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "relation",
          "target"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "recipe_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "knowledge_entry",
            "procedure_definition",
            "task_definition",
            "document_template",
            "checklist_definition",
            "document_instance",
            "checklist_run",
            "task_run",
            "review_decision",
            "publication_recipe",
            "media_asset",
            "rendered_artifact",
            "source_record",
            "claim_record"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "format": {
      "type": "string",
      "enum": [
        "pdf",
        "tex",
        "html",
        "json_view",
        "md",
        "audio",
        "video",
        "interactive"
      ]
    },
    "filepath": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "knowledge_entry",
                  "procedure_definition",
                  "task_definition",
                  "document_template",
                  "checklist_definition",
                  "document_instance",
                  "checklist_run",
                  "task_run",
                  "review_decision",
                  "publication_recipe",
                  "media_asset",
                  "rendered_artifact",
                  "source_record",
                  "claim_record"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "source_ref",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "release_state": {
      "type": "string",
      "enum": [
        "private_build",
        "review_pending",
        "cleared",
        "released",
        "withdrawn"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "lifecycle",
    "authority",
    "access",
    "recipe_ref",
    "format",
    "filepath",
    "sha256",
    "release_state"
  ],
  "additionalProperties": false
}

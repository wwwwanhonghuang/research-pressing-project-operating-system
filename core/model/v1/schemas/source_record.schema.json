{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/operations-os/model/v1/source_record.schema.json",
  "title": "Operations OS source_record canonical v1",
  "description": "Traceable information source; inspection status does not itself verify its scientific truth.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "object",
      "properties": {
        "ja": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ja"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "validated_for_use",
        "deprecated",
        "withdrawn"
      ]
    },
    "responsible_role": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "independent_proposal",
            "external_source",
            "institutional_adopted"
          ]
        },
        "normative_class": {
          "type": "string",
          "enum": [
            "law",
            "regulation",
            "institutional_policy",
            "professional_guidance",
            "operational_proposal",
            "informational"
          ]
        },
        "institutional_approval": {
          "type": "string",
          "enum": [
            "none",
            "unverified",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        },
        "verified_by": {
          "type": "string",
          "minLength": 1
        },
        "applicability_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "origin",
        "normative_class",
        "institutional_approval"
      ],
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "restricted"
          ]
        },
        "may_share_with_external_ai": {
          "type": "boolean"
        },
        "embargo_until": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "classification",
        "may_share_with_external_ai"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          },
          "verification_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation": {
            "type": "string",
            "enum": [
              "applies_to",
              "governed_by",
              "implements",
              "requires",
              "uses",
              "supports",
              "derived_from",
              "supersedes",
              "presents",
              "assesses",
              "produces"
            ]
          },
          "target": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "knowledge_entry",
                  "procedure_definition",
                  "task_definition",
                  "document_template",
                  "checklist_definition",
                  "document_instance",
                  "checklist_run",
                  "task_run",
                  "review_decision",
                  "publication_recipe",
                  "media_asset",
                  "rendered_artifact",
                  "source_record",
                  "claim_record"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "anchor": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "relation",
          "target"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "source_type": {
      "type": "string",
      "enum": [
        "primary_paper",
        "preprint",
        "official_program_record",
        "institutional_policy",
        "statute_or_regulation",
        "interview",
        "dataset",
        "website",
        "other"
      ]
    },
    "creator_or_issuer": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "published_on": {
      "type": "string",
      "format": "date"
    },
    "accessed_on": {
      "type": "string",
      "format": "date"
    },
    "locator_system": {
      "type": "string",
      "minLength": 1
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_checked",
        "identified",
        "source_inspected",
        "content_cross_checked"
      ]
    },
    "rights": {
      "type": "object",
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "rightsholder": {
          "type": "string",
          "minLength": 1
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "clearance": {
          "type": "string",
          "enum": [
            "not_checked",
            "pending",
            "confirmed",
            "restricted",
            "not_applicable"
          ]
        }
      },
      "required": [
        "clearance"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "preserved_copy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "lifecycle",
    "authority",
    "access",
    "source_type",
    "verification_status"
  ],
  "additionalProperties": false
}

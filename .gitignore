# ── LaTeX intermediates ────────────────────────────────────────────
# Compiled PDFs, generated .tex and manifests under build/ ARE tracked;
# only the per-run auxiliary files are ignored.
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.xdv
*.synctex.gz
*.bbl
*.blg

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ── Project instances ──────────────────────────────────────────────
# Real project records may hold personal data, unpublished research,
# interview material or embargoed content. They are not tracked here by
# default. Use `git add -f` for a deliberately synthetic example.
projects/*
!projects/README.md

# ── OS / editor ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
